{
  "name": "use-react-intl-formatters-monorepo",
  "version": "6.0.1",
  "private": true,
  "homepage": "https://github.com/christophehurpeau/use-react-intl-formatters",
  "bugs": {
    "url": "https://github.com/christophehurpeau/use-react-intl-formatters/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/use-react-intl-formatters.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -b",
    "clean:build": "pnpm -r --parallel run clean:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "generate:api": "typedoc --tsconfig tsconfig.doc.json",
    "lint": "pnpm run format && pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC node --test 'packages/*/src/**/*.test.ts'",
    "test:coverage": "TZ=UTC node --test --experimental-test-coverage --test-coverage-include=\"packages/*/src/**/*.ts\" 'packages/*/src/**/*.test.ts'",
    "test:coverage:generate": "mkdir -p generated-docs && TZ=UTC node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=generated-docs/coverage.lcov --test-coverage-include=\"packages/*/src/**/*.ts\" 'packages/*/src/**/*.test.ts'",
    "test:watch": "TZ=UTC node --test 'packages/*/src/**/*.test.ts'",
    "tsc": "tsrs -b",
    "tsc:go": "tsc -b",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.3.0",
    "@pob/eslint-config-typescript-react": "68.4.0",
    "@pob/rollup-esbuild": "11.3.0",
    "@pob/root": "28.6.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">= 12.0.0"
  }
}
